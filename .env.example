# Copia questo file in .env e valorizza almeno GEMINI_API_KEY (oppure attiva Ollama).

# --- Database -----------------------------------------------------------
# Default: SQLite locale, zero setup.
# DATABASE_URL=sqlite:///job_matcher.db
#
# PostgreSQL (opzionale — vedi README, sezione "PostgreSQL"): avvia il
# container con `docker compose up -d`, poi usa questa stringa (utente/
# password/db sono quelli definiti in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://job_matcher:job_matcher@localhost:5432/job_matcher

# --- LLM providers --------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3

LLM_TIMEOUT=60
LLM_CACHE_ENABLED=true

# --- Google Places (opzionale — verifica aziende locali) ------------------
GOOGLE_PLACES_API_KEY=

# --- Scraper — rate limiting -----------------------------------------------
SCRAPER_DELAY_MIN=3.0
SCRAPER_DELAY_MAX=8.0
SCRAPER_TIMEOUT=20
SCRAPER_MAX_LISTINGS_PER_SOURCE=10
SCRAPER_MAX_CONCURRENCY=8
SCRAPER_PROBE_DELAY_MIN=0.5
SCRAPER_PROBE_DELAY_MAX=1.5

# --- Matching ---------------------------------------------------------
DEFAULT_MATCH_THRESHOLD=0.5
KEYWORD_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6

# --- Cache annunci / ATS -----------------------------------------------
LISTING_TTL_HOURS=24
ATS_MAX_LISTINGS_PER_COMPANY=40
ATS_REPROBE_DAYS=30

# --- Poller background (disabilitato di default) ---------------------------
POLL_ENABLED=false
POLL_INTERVAL_SECONDS=3600

# --- Sicurezza ----------------------------------------------------------
# Header X-API-Token richiesto su ogni chiamata. Vuoto = nessuna protezione (solo dev).
API_TOKEN=local-dev-token-2026
